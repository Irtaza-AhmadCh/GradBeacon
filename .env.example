# GradBeacon configuration — copy to .env (local) or enter in your host's secret manager.
# NEVER commit real values. Names only here; placeholders are safe.

# ---- App ----
APP_ENV=development              # development | production
APP_MODE=live                    # live | fallback_only | demo_replay
LOG_LEVEL=INFO
ALLOWED_ORIGINS=                 # CSV of frontend origins, e.g. https://gradbeacon.example.app
TRUST_PROXY_HEADERS=false        # true only behind a trusted proxy that sets X-Forwarded-For

# ---- Required for live research ----
LLM_PROVIDER=gemini             # gemini | groq (keys below are read for the selected provider)
GEMINI_API_KEY_1=                # Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY_2=                # Optional failover key — use a DIFFERENT Google Cloud project (quota is per project)
GEMINI_API_KEY_3=                # Optional failover key
GROQ_API_KEY_1=                  # GroqCloud API key (store in host secret manager in deployment)
GROQ_API_KEY_2=                  # Optional failover key
GROQ_API_KEY_3=                  # Optional failover key
GROQ_API_KEY_4=                  # Optional failover key
GROQ_API_KEY_5=                  # Optional failover key
GROQ_API_KEY_6=                  # Optional failover key
TAVILY_API_KEY=                  # https://app.tavily.com -> API Keys

# ---- Required for outreach approval tokens (>= 32 random chars) ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APPROVAL_TOKEN_SECRET=

# ---- LLM tuning (optional) ----
LLM_MODEL=gemini-3.5-flash         # groq: openai/gpt-oss-120b
LLM_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-latest,gemini-3-flash-preview,gemini-3.1-flash-lite  # used when a model's daily quota runs out (empty for groq)
LLM_WRITING_MODEL=               # defaults to LLM_MODEL
LLM_EFFORT_RESEARCH=low
LLM_EFFORT_EXTRACTION=low
LLM_EFFORT_WRITING=medium
LLM_TIMEOUT_SECONDS=60

# ---- Email (SENDING NOT IMPLEMENTED YET — owner will add a provider) ----
EMAIL_PROVIDER=none
EMAIL_SEND_MODE=live             # disabled | sandbox | live  (used once a sender exists)
EMAIL_SANDBOX_TO=                # team inbox for sandbox mode

# ---- Budgets / limits (optional; initial assumptions) ----
MAX_RESULTS_HARD_CAP=15
DEFAULT_TARGET_RESULTS=8
MAX_PROFESSORS=8
MAX_LOOP_TURNS=12
MAX_SEARCH_CALLS=8
MAX_PAGE_FETCHES=14
MAX_LLM_CALLS=40
FIRST_BATCH_CANDIDATES=4
REQUEST_DEADLINE_SECONDS=180
VERIFY_DEADLINE_SECONDS=60
PROFESSOR_DEADLINE_SECONDS=150
MAX_CONCURRENT_JOBS=4
RATE_RESEARCH_PER_10MIN=5
EXTRA_OFFICIAL_DOMAINS=          # CSV of non-.edu domains to treat as official (owner-approved only)

# ---- Demo replay ----
DEMO_REPLAY_PATH=data/demo_replay.json
DEMO_REPLAY_SPEEDUP=4
